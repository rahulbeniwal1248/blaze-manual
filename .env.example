# Get API credentials from https://my.telegram.org/apps
API_ID=
API_HASH=
# Create this token with @BotFather.
BOT_TOKEN=
# Telegram numeric user IDs allowed to control the bot, comma-separated.
OWNER_IDS=

# Optional MongoDB connection details for deployments that use it.
MONGO_URI=
MONGO_DB=blaze_forward_bot

# Optional runtime settings
DATA_FILE=data.json
SESSION_DIR=sessions
STATUS_UPDATE_EVERY=10
