# Telegram API credentials from https://my.telegram.org/apps
API_ID=123456
API_HASH=your_api_hash

# Main controller bot token from @BotFather
BOT_TOKEN=123456:ABCDEF

# Comma-separated Telegram numeric user IDs allowed to control the bot
OWNER_IDS=123456789

# Optional: persistent duplicate tracking. Leave empty to use local JSON only.
MONGO_URI=
MONGO_DB=blaze_forward_bot

# Optional runtime tuning
DATA_FILE=data.json
SESSION_DIR=sessions
STATUS_UPDATE_EVERY=10
